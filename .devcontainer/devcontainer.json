{
  "name": "DocuFlow demo",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq libgl1 libglib2.0-0 >/dev/null && pip install --user -q -r requirements.txt && cp -n .env.example .env",
  "postStartCommand": "setsid nohup python -m uvicorn app.main:app --host 0.0.0.0 --port 8001 > /tmp/app.log 2>&1 < /dev/null &",
  "postAttachCommand": "gh codespace ports visibility 8001:public -c \"$CODESPACE_NAME\" >/dev/null 2>&1 || true",
  "forwardPorts": [
    8001
  ],
  "portsAttributes": {
    "8001": {
      "label": "DocuFlow demo",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}
