# Copy this file to .env and fill in what you need. Everything is optional.

# Free key from https://console.groq.com/keys . Without it the offline reader is used.
GROQ_API_KEY=
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Where the landing page "Try free" buttons send people (leave empty to open the live demo)
CONTACT_EMAIL=
CONTACT_WHATSAPP=

# Demo account shown by the "Try with sample invoices" button
DEMO_EMAIL=demo@docuflow.app
DEMO_PASSWORD=demo1234

# Minutes a person needs to type one invoice by hand (used for "time saved")
MANUAL_MINUTES_PER_DOC=5

# PORT=8001
# DATA_DIR=./data
